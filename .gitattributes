# Normalize line endings by default
* text=auto

# Scripts must keep CRLF so they run reliably on Windows
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# XML-based TwinCAT and packaging sources
*.nuspec      text eol=crlf
*.tsproj      text eol=crlf
*.tspproj     text eol=crlf
*.plcproj     text eol=crlf
*.xti         text eol=crlf
*.vssettings  text eol=crlf
*.vsdir       text eol=crlf
*.TcPOU       text eol=crlf
*.TcDUT       text eol=crlf
*.TcGVL       text eol=crlf

# Binary payloads
*.library            binary
*.compiled-library   binary
*.tizip              binary
*.tszip              binary
*.tpzip              binary
*.app                binary
*.png                binary
*.ico                binary
*.exe                binary

# The TwinCAT Package Manager installer is large - track it with Git LFS if it is ever committed
TwinCAT-Package-Manager-*.exe filter=lfs diff=lfs merge=lfs -text
